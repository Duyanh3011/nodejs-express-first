<div class="mt-4">
    <h3>Deleted course</h3>
    <a href="/me/stored/courses">Return to My course</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Level</th>
                <th scope="col">Deleted Date</th>
                <th scope="col" colspan="2" class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            {{#each courses}}
            <tr>
                <th scope="row">{{sum @index 1}}</th>
                {{!-- //custom helpers handlebarjs -> express handlebar --}}
                <td>{{this.name}}</td>
                <td>{{this.level}}</td>
                <td>{{this.deletedAt}}</td>
                <td>
                    <a class="btn-restore btn btn-link" href="#" data-id="{{this._id}}">Recover</a>
                </td>
                <td>
                    <a class="btn btn-link" href="#" data-toggle="modal" data-id="{{this._id}}"
                        data-target="#delete-course-modal">Delete permanently</a>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6" class="text-center">Trash is empty.
                    <a href="/me/stored/courses">Return</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

{{!-- CF delete --}}
<!-- Modal -->
<div class="modal fade" id="delete-course-modal" tabindex="-1" aria-labelledby="delete-course-modal-label"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-course-modalLabel">Permanent delete confirm</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                This deletion can not be recovered. Do you still want to delete?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="btn-delete-course" type="button" class="btn btn-danger">Delete Permanently</button>
            </div>
        </div>
    </div>
</div>

{{!-- Delete hidden form --}}
<form action="" method="post" name="delete-course-form"></form>
<form action="" method="post" name="restore-course-form"></form>

<script>
    document.addEventListener("DOMContentLoaded", function () { // $ err => dom load done => function
        // when dialog cf show 
         var courseID
         var deleteFrom = document.forms['delete-course-form']
         var restoreForm = document.forms['restore-course-form']
        var btnDeleteCourse = document.getElementById('btn-delete-course')
        var restoreBtn = $('.btn-restore'); //$ jgory

        $('#delete-course-modal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget) // Button that triggered the modal
             courseID = button.data('id') // Extract info from data-* attributes
            console.log(courseID)
        })


        btnDeleteCourse.onclick = function (event) {
            deleteFrom.action=`/courses/${courseID}/force?_method=delete`
            deleteFrom.submit()
        }

        restoreBtn.click(function (e) {
            e.preventDefault()
            console.log("restore", $(this).data("id"))

            restoreForm.action=`/courses/${$(this).data("id")}/restore?_method=PATCH`
            restoreForm.submit()
        })
    })
</script>